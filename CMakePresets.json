{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release",
      "description": "Target 64-bit Windows with Release configuration",
      "inherits": "base",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    },
    {
      "name": "x64-debug",
      "displayName": "x64 Debug",
      "description": "Target 64-bit Windows with Debug configuration",
      "inherits": "base",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    },
    {
      "name": "x86-release",
      "displayName": "x86 Release",
      "description": "Target 32-bit Windows with Release configuration",
      "inherits": "base",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      }
    },
    {
      "name": "x86-debug",
      "displayName": "x86 Debug",
      "description": "Target 32-bit Windows with Debug configuration",
      "inherits": "base",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-release",
      "configurePreset": "x64-release",
      "configuration": "Release"
    },
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "x86-release",
      "configurePreset": "x86-release",
      "configuration": "Release"
    },
    {
      "name": "x86-debug",
      "configurePreset": "x86-debug",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "x64-release",
      "configurePreset": "x64-release",
      "configuration": "Release"
    },
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "x86-release",
      "configurePreset": "x86-release",
      "configuration": "Release"
    },
    {
      "name": "x86-debug",
      "configurePreset": "x86-debug",
      "configuration": "Debug"
    }
  ]
}
