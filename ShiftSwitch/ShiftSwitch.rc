#include "resource.h"

// Build the version string from the numeric macros of Version.props. The
// project file used to pass VERSION_STRING as a quoted define, which rc.exe
// expanded to an empty string, so FileVersion and ProductVersion were blank.
#define VER_STR_(x) #x
#define VER_STR(x) VER_STR_(x)
#define VERSION_STRING VER_STR(VERSION_MAJOR) "." VER_STR(VERSION_MINOR) "." VER_STR(VERSION_PATCH)

#define APSTUDIO_READONLY_SYMBOLS
